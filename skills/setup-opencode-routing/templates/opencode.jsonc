{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6.1-sol",
  "default_agent": "build",
  "subagent_depth": 1,
  "tool_output": { "max_lines": 300, "max_bytes": 24000 },
  "compaction": { "auto": true, "prune": true },
  "agent": {
    "build": {
      "model": "openai/gpt-6.1-sol",
      "variant": "medium",
      "prompt": "{file:./prompts/cost-aware-coordinator.md}",
      "permission": {
        "skill": {
          "ask-matt": "deny",
          "brainstorming": "deny",
          "executing-plans": "deny",
          "finishing-a-development-branch": "deny",
          "implement": "deny",
          "implement-spec": "deny",
          "pr": "deny",
          "requesting-code-review": "deny",
          "subagent-driven-development": "deny",
          "systematic-debugging": "deny",
          "test-driven-development": "deny",
          "using-superpowers": "deny",
          "verification-before-completion": "deny",
          "writing-plans": "deny",
          "writing-skills": "deny"
        },
        "task": {
          "*": "deny",
          "explore": "allow",
          "researcher": "allow",
          "architect": "allow",
          "implement-small": "allow",
          "general": "allow",
          "implement-complex": "allow",
          "verify": "allow"
        }
      }
    },
    "plan": {
      "model": "openai/gpt-6.1-sol",
      "variant": "medium",
      "prompt": "{file:./prompts/cost-aware-coordinator.md}",
      "permission": {
        "skill": {
          "ask-matt": "deny",
          "brainstorming": "deny",
          "executing-plans": "deny",
          "finishing-a-development-branch": "deny",
          "implement": "deny",
          "implement-spec": "deny",
          "pr": "deny",
          "requesting-code-review": "deny",
          "subagent-driven-development": "deny",
          "systematic-debugging": "deny",
          "test-driven-development": "deny",
          "using-superpowers": "deny",
          "verification-before-completion": "deny",
          "writing-plans": "deny",
          "writing-skills": "deny"
        },
        "task": { "*": "deny", "explore": "allow", "researcher": "allow", "architect": "allow" }
      }
    },
    "deep": { "disable": true },
    "general": {
      "mode": "subagent",
      "model": "openai/gpt-6.1-sol",
      "variant": "medium",
      "description": "Standard multi-file implementation, moderate debugging, and independent reviews.",
      "prompt": "{file:./prompts/implementation-worker.md}",
      "permission": { "task": "deny" }
    },
    "explore": {
      "mode": "subagent",
      "model": "openai/gpt-6-luna",
      "variant": "medium",
      "permission": { "task": "deny" }
    }
  }
}
